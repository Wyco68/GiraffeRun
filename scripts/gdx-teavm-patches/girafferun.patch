diff --git a/backends/backend-web/src/main/java/com/github/xpenatan/gdx/teavm/backends/web/WebViewportScale.java b/backends/backend-web/src/main/java/com/github/xpenatan/gdx/teavm/backends/web/WebViewportScale.java
